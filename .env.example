# Discord Bot Environment Configuration
# Copy this file to .env and fill in your values

# ── Required ─────────────────────────────────────────────
# Your bot token from Discord Developer Portal
TOKEN=your_bot_token_here

# Your bot's Client ID (Application ID) from Developer Portal
CLIENT_ID=your_client_id_here

# MongoDB connection string
# Local: mongodb://localhost:27017/communitybot
# Atlas:  mongodb+srv://user:password@cluster.mongodb.net/communitybot
MONGODB_URI=mongodb://localhost:27017/communitybot

# ── Optional ─────────────────────────────────────────────
# Guild ID for instant command deployment during development
# Leave blank for global deployment
GUILD_ID=

# Bot environment (development | production)
NODE_ENV=production
